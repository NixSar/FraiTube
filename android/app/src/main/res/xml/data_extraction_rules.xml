<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of the app is copied to a cloud backup or to another phone. A copied database would give two
  phones the same computer ID, and each would then delete the other's sync files. The app's own backup
  and sync carry the data to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
