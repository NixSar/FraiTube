{
  "name": "@fraitube/shell",
  "productName": "FraiTube",
  "version": "0.9.0",
  "description": "A desktop YouTube app for Windows and Linux that needs no Google account.",
  "author": "NixSar",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && node ../../scripts/package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "7z-wasm": "1.2.0",
    "@fraitube/app-api": "workspace:*",
    "@fraitube/backup": "workspace:*",
    "@fraitube/player": "workspace:*",
    "@fraitube/sabr": "workspace:*",
    "@fraitube/sponsorblock": "workspace:*",
    "@fraitube/storage": "workspace:*",
    "@fraitube/subscriptions": "workspace:*",
    "@fraitube/sync": "workspace:*",
    "@fraitube/youtube": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.8",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  }
}
