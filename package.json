{
  "name": "fraitube",
  "version": "0.9.5",
  "description": "A desktop YouTube app for Windows and Linux that needs no Google account.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "NixSar",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @fraitube/shell dev",
    "build": "pnpm --filter @fraitube/shell build",
    "start": "pnpm --filter @fraitube/shell start",
    "package": "pnpm --filter @fraitube/shell package",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:linux": "node scripts/test-linux.mjs",
    "postinstall": "node scripts/electron-download.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
